{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react"],
  "rules": {
    "react/jsx-no-literals": [
      "error",
      { "allowedStrings": ["Quoly", "Gmail", "›", "·", "%", ":"] }
    ]
  },
  "overrides": [
    {
      "files": ["src/design-system/showcase/**"],
      "rules": { "react/jsx-no-literals": "off" }
    }
  ]
}
